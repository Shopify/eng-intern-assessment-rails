<h1>New Article</h1>

<%= form_with(model: @article, url: articles_create_path, local: true) do |form| %>
  <% if @article.errors.any? %>
    <div id="error_explanation" class="alert alert-danger">
      <h2><%= pluralize(@article.errors.count, "error") %> prohibited this article from being saved:</h2>
      <ul>
        <% @article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, class: 'form-label' %>
    <%= form.text_field :title, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :content, class: 'form-label' %>
    <%= form.text_area :content, class: 'form-control', rows: 10 %>
  </div>

  <div class="field">
    <%= form.label :author, class: 'form-label' %>
    <%= form.text_field :author, class: 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :date, class: 'form-label' %>
    <%= form.date_field :date, class: 'form-control' %>
  </div>

  <div class="actions">
    <%= form.submit 'Create Article', class: 'btn btn-primary' %>
    <%= link_to 'Cancel', articles_index_path, class: 'btn btn-secondary' %>
  </div>
<% end %>
